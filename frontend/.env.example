# Optional override. When empty, the site uses G-X750JBGTXR.
VITE_GA_MEASUREMENT_ID=
# Google Search Console HTML tag verification token
VITE_GOOGLE_SITE_VERIFICATION=
# Public contact phone. Leave empty to hide the phone everywhere on the public site.
