# Optional overrides for Admin → Google Analytics.
# When these are empty, the API reports measurement G-X750JBGTXR and property 566029672.
GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
# Stringified Google Cloud service account JSON with Analytics Read-only access.
# Required before realtime Google active users can load. The first-party visitor calendar works without it.
GA_SERVICE_ACCOUNT_JSON=
# Search Console HTML meta verification token (the content value only, not the whole tag).
GOOGLE_SITE_VERIFICATION=
