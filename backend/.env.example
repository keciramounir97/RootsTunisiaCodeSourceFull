# ===============================
# SERVER
# ===============================
# Required: production | development
NODE_ENV=development
# Required: Port for the backend server
PORT=5000
# Required: Base URL of this API
API_URL=http://localhost:5000

# ===============================
# DATABASE (Knex uses DB_* vars)
# ===============================
# Required: Database client
DB_CLIENT=mysql2
# Required: Database host
DB_HOST=localhost
# Required: Database port
DB_PORT=3306
# Required: Database name (should be Tunisia-specific)
DB_NAME=rootstunisia_db
# Required: Database user
DB_USER=root
# Required: Database password
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=5
DB_ACQUIRE_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=10000

# ===============================
# AUTH (JWT)
# ===============================
# Required: A strong random secret for JWT signing (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET
# Required: Token expiry duration
JWT_EXPIRES_IN=30d
# Optional: Reset code time-to-live in seconds
RESET_CODE_TTL=900
# Optional: Session TTL in seconds
SESSION_TTL_SECONDS=2592000

# ===============================
# CORS
# ===============================
# Required: Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://rootstunisia.com,https://www.rootstunisia.com,https://frontend.rootstunisia.com,https://server.rootstunisia.com
CORS_STRICT=true

# ===============================
# RATE LIMITING
# ===============================
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# ===============================
# MAIL (SMTP)
# ===============================
# Required: SMTP server host
SMTP_HOST=mail.rootstunisia.com
# Required: SMTP port (465 for SSL, 587 for TLS)
SMTP_PORT=465
SMTP_SECURE=true
# Required: SMTP credentials
SMTP_USER=admin@rootstunisia.com
SMTP_PASS=CHANGE_ME
# Required: From address for outgoing emails
EMAIL_FROM=Roots Tunisia <admin@rootstunisia.com>

# ===============================
# APP SETTINGS
# ===============================
SETTINGS_CACHE_TTL_MS=15000
OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_EXPIRES_MINUTES=15
MAX_LOGIN_ATTEMPTS=5

# ===============================
# SEED (dev/bootstrap)
# ===============================
# Optional: Initial admin account for bootstrapping
SEED_ADMIN_EMAIL=admin@rootstunisia.com
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_FULL_NAME=Tunisia Admin
SEED_ADMIN_ROLE_ID=1
SEED_ADMIN_FORCE=true
